{
  "name": "openstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/FactsConfig/index.d.ts",
      "import": "./dist/FactsConfig/index.js"
    },
    "./ConfigCore": {
      "types": "./dist/ConfigCore/index.d.ts",
      "import": "./dist/ConfigCore/index.js"
    },
    "./FactsConfig": {
      "types": "./dist/FactsConfig/index.d.ts",
      "import": "./dist/FactsConfig/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "schema:generate": "npm run build && node scripts/generate-facts-definition-schema.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
