{
  "name": "openstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "openstrap": "./dist/CLI/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/Modules/Facts/Facts.d.ts",
      "import": "./dist/Modules/Facts/Facts.js"
    },
    "./Blueprint": {
      "types": "./dist/Modules/Blueprint/index.d.ts",
      "import": "./dist/Modules/Blueprint/index.js"
    },
    "./ConfigCore": {
      "types": "./dist/ConfigCore/index.d.ts",
      "import": "./dist/ConfigCore/index.js"
    },
    "./Facts/Facts": {
      "types": "./dist/Modules/Facts/Facts.d.ts",
      "import": "./dist/Modules/Facts/Facts.js"
    },
    "./Requirements": {
      "types": "./dist/Modules/Requirements/index.d.ts",
      "import": "./dist/Modules/Requirements/index.js"
    }
  },
  "imports": {
    "#types/*": "./src/types/*",
    "#features/*": "./src/features/*"
  },
  "workspaces": [
    "contract"
  ],
  "scripts": {
    "binaries": "rm -rf bin && npm run bundle && pkg bin/openstrap.cjs --config pkg.config.mjs && rm bin/openstrap.cjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'module',imports:{'#types/*':'./types/*','#features/*':'./features/*'}},null,2))\"",
    "bundle": "esbuild src/CLI/index.ts --bundle --platform=node --target=node24 --format=cjs --minify --define:import.meta.url=undefined --outfile=bin/openstrap.cjs",
    "schema:generate": "tsx src/Modules/Blueprint/Schema/index.ts",
    "schema:migrations": "drizzle-kit generate && node scripts/inline-migrations.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openstrap/plugin-contract": "*",
    "drizzle-orm": "1.0.0-rc.4",
    "env-paths": "4.0.0",
    "lilconfig": "3.1.3",
    "semver": "7.8.5",
    "systeminformation": "5.33.1",
    "which": "7.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/semver": "7.7.1",
    "@types/which": "3.0.4",
    "@yao-pkg/pkg": "6.22.0",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
