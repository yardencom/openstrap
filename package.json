{
  "name": "openstrap",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "openstrap": "./dist/CLI/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/Modules/Facts/Facts.d.ts",
      "import": "./dist/Modules/Facts/Facts.js"
    },
    "./Blueprint": {
      "types": "./dist/Modules/Blueprint/index.d.ts",
      "import": "./dist/Modules/Blueprint/index.js"
    },
    "./ConfigCore": {
      "types": "./dist/ConfigCore/index.d.ts",
      "import": "./dist/ConfigCore/index.js"
    },
    "./Facts/Facts": {
      "types": "./dist/Modules/Facts/Facts.d.ts",
      "import": "./dist/Modules/Facts/Facts.js"
    },
    "./Requirements": {
      "types": "./dist/Modules/Requirements/index.d.ts",
      "import": "./dist/Modules/Requirements/index.js"
    },
    "./Plugin": {
      "types": "./dist/Plugin/index.d.ts",
      "import": "./dist/Plugin/index.js"
    },
    "./Transport": {
      "types": "./dist/Transport/index.d.ts",
      "import": "./dist/Transport/index.js"
    },
    "./StateStore": {
      "types": "./dist/StateStore/index.d.ts",
      "import": "./dist/StateStore/index.js"
    },
    "./Secrets": {
      "types": "./dist/Secrets/index.d.ts",
      "import": "./dist/Secrets/index.js"
    }
  },
  "scripts": {
    "build": "find dist -mindepth 1 -maxdepth 1 ! -name agent -exec rm -rf {} + 2>/dev/null; tsc -p tsconfig.build.json",
    "agent:build": "tsx src/Modules/Facts/Reading/Agent/BuildAgent.ts",
    "schema:generate": "tsx src/Modules/Blueprint/Schema/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "env-paths": "^4.0.0",
    "lilconfig": "^3.1.3",
    "semver": "^7.8.2",
    "systeminformation": "^5.33.1",
    "tar": "^7.5.22",
    "which": "^6.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.1",
    "@types/which": "^3.0.4",
    "@yao-pkg/pkg": "^6.21.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
